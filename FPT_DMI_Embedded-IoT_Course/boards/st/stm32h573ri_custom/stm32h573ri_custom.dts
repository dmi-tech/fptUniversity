/dts-v1/;
#include <st/h5/stm32h573Xi.dtsi>
#include "stm32h573ri_custom-pinctrl.dtsi"
/ {
    model="Custom STM32H573RIV6";
    compatible="st,stm32h573ri-custom";

    chosen {
        zephyr,console=&uart5;
        zephyr,shell-uart=&uart5;
        zephyr,sram=&sram1; zephyr,flash=&flash0;
        zephyr,code-partition=&slot0_partition;
        zephyr,canbus=&fdcan1;
        };

    leds {
        compatible="gpio-leds";
        /* LED5 "LED LIFE": anode to +3V3 via R81, cathode to PA8 -> active low */
        user_led: led_0 {
            gpios=<&gpioa 8 GPIO_ACTIVE_LOW>;
            label="LED LIFE";
        };
    };

    /*
     * Relays: MCU -> ISO7730 U12 -> BC817 -> coil, high = energised.
     * The schematic net names are reversed relative to the wiring; these
     * follow the wiring (PB5 drives RL1, PA15 drives RL3).
     */
    relays {
        compatible="gpio-leds";
        relay_1: relay_1 { gpios=<&gpiob 5 GPIO_ACTIVE_HIGH>;  label="Relay 1"; };
        relay_2: relay_2 { gpios=<&gpiob 4 GPIO_ACTIVE_HIGH>;  label="Relay 2"; };
        relay_3: relay_3 { gpios=<&gpioa 15 GPIO_ACTIVE_HIGH>; label="Relay 3"; };
    };

    /* Isolated inputs: PC814 opto -> ISO7730 U10 (push-pull), energised = low */
    digital_inputs {
        compatible="gpio-keys";
        input_1: input_1 { gpios=<&gpioc 13 GPIO_ACTIVE_LOW>; label="Input 1"; };
        input_2: input_2 { gpios=<&gpioc 14 GPIO_ACTIVE_LOW>; label="Input 2"; };
        input_3: input_3 { gpios=<&gpioc 15 GPIO_ACTIVE_LOW>; label="Input 3"; };
    };

    buttons {
        compatible = "gpio-keys";
        user_btn: button_0 {
            gpios = <&gpioa 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "Page Button";
        };
    };

    can_transceiver0: can-phy0 {
        compatible="can-transceiver-gpio";
        /* TCAN1057 S via ISO7731 U7, R90 pull-up: high = silent */
        standby-gpios=<&gpiob 0 GPIO_ACTIVE_HIGH>;
        max-bitrate=<1000000>;
        #phy-cells=<0>;
        };

    aliases {
        led0=&user_led;
        relay1=&relay_1; relay2=&relay_2; relay3=&relay_3;
        input1=&input_1; input2=&input_2; input3=&input_3;
    };
};

&clk_hsi { status="okay"; };

&clk_hsi48 { status="okay"; };

&clk_lsi { status="okay"; };

&pll1 {
    div-m=<32>;
    mul-n=<250>;
    div-p=<2>;
    div-q=<10>;
    div-r=<2>;
    clocks=<&clk_hsi>;
    status="okay";
};

&rcc {
    clocks=<&pll1>;
    clock-frequency=<DT_FREQ_M(250)>;
    ahb-prescaler=<1>;
    apb1-prescaler=<1>;
    apb2-prescaler=<1>;
    apb3-prescaler=<1>;
    };

&flash0 {
    partitions {
        compatible="fixed-partitions";
        #address-cells=<1>;
        #size-cells=<1>;

boot_partition:      partition@0      { label="mcuboot";       reg=<0x0      0x20000>; read-only; };
slot0_partition:     partition@20000  { label="image-0";       reg=<0x20000  0xb0000>; };
scratch_partition:   partition@d0000  { label="image-scratch"; reg=<0xd0000  0x20000>; };
slot1_partition:     partition@f0000  { label="image-1";       reg=<0xf0000  0xb0000>; };
storage_partition:   partition@1a0000 { label="config-a";      reg=<0x1a0000 0x8000>; };
storage_b_partition: partition@1a8000 { label="config-b";      reg=<0x1a8000 0x8000>; };
marker_partition:    partition@1b0000 { label="swapmark";      reg=<0x1b0000 0x2000>; }; }; };


&usart1 {
    pinctrl-0=<&usart1_tx_pb14 &usart1_rx_pb15>;
    pinctrl-names="default";
    current-speed=<115200>;
    status="okay";
    };

&usart2 {
    pinctrl-0=<&usart2_tx_pa2 &usart2_rx_pa3>;
    pinctrl-names="default";
    current-speed=<115200>;
    status="okay";
    };

&uart5 {
    pinctrl-0=<&uart5_tx_pb13 &uart5_rx_pb12>;
    pinctrl-names="default";
    current-speed=<115200>;
    status="okay";
    };

&uart4 {
    pinctrl-0=<&uart4_tx_pa0 &uart4_rx_pa1>;
    pinctrl-names="default";
    current-speed=<9600>;
    status="okay";
    };

&usart6 {
    pinctrl-0=<&usart6_tx_pc6 &usart6_rx_pc7>;
    pinctrl-names="default";
    current-speed=<921600>;
    status="okay";
    };

&fdcan1 {
    clocks=<&rcc STM32_CLOCK_BUS_APB1_2 0x00000200>,<&rcc STM32_SRC_PLL1_Q FDCAN_SEL(1)>;
    pinctrl-0=<&fdcan1_tx_pb7 &fdcan1_rx_pb8>;
    pinctrl-names="default";
    phys=<&can_transceiver0>;
    bitrate=<500000>;
    sample-point=<875>;
    status="okay";
    };

&i2c1 {
    clocks=<&rcc STM32_CLOCK_BUS_APB1 0x00200000>,<&rcc STM32_SRC_HSI I2C1_SEL(2)>;
    pinctrl-0=<&i2c1_scl_pb6 &i2c1_sda_pb9>;
    pinctrl-names="default";
    clock-frequency=<I2C_BITRATE_FAST>;
    status="okay";
    };

&i2c2 {
    clocks=<&rcc STM32_CLOCK_BUS_APB1 0x00400000>,<&rcc STM32_SRC_HSI I2C2_SEL(2)>;
    pinctrl-0=<&i2c2_scl_pb10 &i2c2_sda_pb11>;
    pinctrl-names="default";
    clock-frequency=<I2C_BITRATE_STANDARD>;
    status="okay";

    sht41: sht4x@44 {
        compatible="sensirion,sht4x";
        reg=<0x44>; repeatability=<2>;
        };
    };

&spi1 {
    pinctrl-0=<&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
    pinctrl-names="default";
    cs-gpios=<&gpioa 4 GPIO_ACTIVE_LOW>;
    status="okay";

    w5500: w5500@0 {
        compatible="wiznet,w5500";
        reg=<0>; spi-max-frequency=<14000000>;
        int-gpios=<&gpioc 4 GPIO_ACTIVE_LOW>;
        reset-gpios=<&gpioc 5 GPIO_ACTIVE_LOW>;
        local-mac-address=[00 08 DC 01 02 03];
        };
    };

&spi2 {
    /* Kernel clock = PLL1_Q (50 MHz): /256 gives ~195 kHz for the ST7920.
     * With the bus clock alone the driver divides 250 MHz and cannot go
     * below ~977 kHz, so every transfer is rejected. */
    clocks=<&rcc STM32_CLOCK_BUS_APB1 0x00004000>,<&rcc STM32_SRC_PLL1_Q SPI2_SEL(0)>;
    pinctrl-0 = <&spi2_sck_pa9 &spi2_mosi_pc1>;
    pinctrl-names = "default";
    cs-gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>;
    status = "okay";

    st7920: st7920@0 {
        compatible = "vnd,spi-device";
        reg = <0>;
        spi-max-frequency = <200000>;
        };
    };

&sdmmc1 {
    pinctrl-0=<&sdmmc1_d0_pc8 &sdmmc1_d1_pc9 &sdmmc1_d2_pc10 &sdmmc1_d3_pc11 &sdmmc1_ck_pc12 &sdmmc1_cmd_pb2>;
    pinctrl-names="default";
    clocks=<&rcc STM32_CLOCK(AHB4, 11U)>,<&rcc STM32_SRC_HSI48 SDMMC1_SEL(0)>;
    bus-width=<1>; disk-name="SD"; status="okay";
    };

&gpioa { status="okay"; };

&gpiob { status="okay"; };

&gpioc { status="okay"; };

&gpiod { status="okay"; };

&rng { status="okay"; };
