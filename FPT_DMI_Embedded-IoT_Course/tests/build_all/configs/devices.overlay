/* rtc, dht11, hcsr04, bh1750, encoder, motor (PWM), servo, ethernet: from the READMEs. */
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	dht11: dht11 {
		compatible = "aosong,dht";
		dio-gpios = <&gpioe 0 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
	};

	hcsr04: hcsr04 {
		compatible = "hc-sr04";
		trigger-gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>;
		echo-gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;
	};

	encoder: encoder {
		compatible = "gpio-qdec";
		gpios = <&gpioc 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>,
			<&gpioc 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps-per-period = <4>;
		zephyr,axis = <INPUT_REL_WHEEL>;
		sample-time-us = <2000>;
		idle-timeout-ms = <200>;
	};

	motor_pwm {
		compatible = "pwm-leds";
		motor: motor_0 {
			pwms = <&pwm2 3 PWM_KHZ(1) PWM_POLARITY_NORMAL>;
		};
	};

	servos {
		compatible = "pwm-leds";
		servo_a: servo_0 {
			pwms = <&pwm12 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		servo_b: servo_1 {
			pwms = <&pwm12 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	aliases {
		rtc0 = &bm8563;
		dht0 = &dht11;
		distance0 = &hcsr04;
		light0 = &bh1750;
		encoder0 = &encoder;
		motor0 = &motor;
		servo0 = &servo_a;
		servo1 = &servo_b;
	};
};

&gpioe { status = "okay"; };

/* With CONFIG_INPUT=y every gpio-keys node of the board needs a key code */
&user_btn { zephyr,code = <INPUT_KEY_ENTER>; };
&input_1 { zephyr,code = <INPUT_KEY_1>; };
&input_2 { zephyr,code = <INPUT_KEY_2>; };
&input_3 { zephyr,code = <INPUT_KEY_3>; };

/* Pins taken from these peripherals of the board DTS */
&usart1 { status = "disabled"; };  /* PB14, PB15: servos */
&usart2 { status = "disabled"; };  /* PA2: motor */
&usart6 { status = "disabled"; };  /* PC6, PC7: encoder */
&spi2 { status = "disabled"; };    /* PC0, PC2: HC-SR04 */

&i2c1 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	bh1750: bh1750@23 {
		compatible = "rohm,bh1750";
		reg = <0x23>;
	};
};

&i2c2 {
	bm8563: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
	};
};

&pinctrl {
	tim2_ch3_pa2: tim2_ch3_pa2 {
		pinmux = <STM32_PINMUX('A', 2, AF1)>;
	};
	tim12_ch1_pb14: tim12_ch1_pb14 {
		pinmux = <STM32_PINMUX('B', 14, AF2)>;
	};
	tim12_ch2_pb15: tim12_ch2_pb15 {
		pinmux = <STM32_PINMUX('B', 15, AF2)>;
	};
};

&timers2 {
	st,prescaler = <0>;
	status = "okay";
	pwm2: pwm {
		pinctrl-0 = <&tim2_ch3_pa2>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&timers12 {
	st,prescaler = <99>;
	status = "okay";
	pwm12: pwm {
		pinctrl-0 = <&tim12_ch1_pb14 &tim12_ch2_pb15>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&w5500 {
	local-mac-address = [00 08 DC 01 02 07];
};
