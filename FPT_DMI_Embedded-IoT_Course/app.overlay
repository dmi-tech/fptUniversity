/*
 * app.overlay - example MQTT (DHT11 + Relay 1).
 *
 * Used here: SPI1 + W5500 (Ethernet), RNG (network), GPIO for DHT11 and Relay 1.
 * Everything else the board enables is switched off below.
 */

/* ---- Ethernet: every board on the same network needs its own MAC ---- */
&w5500 {
	local-mac-address = [00 08 DC 01 02 07];   /* change the last byte (hex) */
};

/ {
	/* DHT11 DATA on PE0 (U16-8) */
	dht11: dht11 {
		compatible = "aosong,dht";
		dio-gpios = <&gpioe 0 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
	};

	/* Relay 1 on PC2 (U16-5): output to an external relay module */
	output {
		compatible = "gpio-leds";
		relay: relay_1 {
			gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;
			label = "Relay 1 - PC2";
		};
	};

	aliases {
		dht0 = &dht11;
		out0 = &relay;
	};
};

&gpioe { status = "okay"; };   /* the board only enables gpioa..gpiod */

/* ---- Not used in this example: switched off ---- */
&usart1 { status = "disabled"; };   /* PB14/PB15 */
&usart2 { status = "disabled"; };   /* PA2/PA3 */
&uart4  { status = "disabled"; };   /* PA0/PA1, RS485 */
&uart5  { status = "disabled"; };   /* PB12/PB13, only MCUboot logs here */
&usart6 { status = "disabled"; };   /* PC6/PC7 */
&fdcan1 { status = "disabled"; };   /* CAN */
&i2c1   { status = "disabled"; };   /* PB6/PB9, LCD */
&i2c2   { status = "disabled"; };   /* PB10/PB11 */
&sht41  { status = "disabled"; };   /* SHT41 on I2C2 */
&spi2   { status = "disabled"; };   /* PA9/PC1/PC0 */
&sdmmc1 { status = "disabled"; };   /* SD card */
